{
  "schema_version": "1.0",
  "experiment_set": "q1_minimal",
  "purpose": "Fast but meaningful experiment package to validate the Q1 pipeline before expensive full experiments.",
  "output_dir": "outputs/q1_minimal",
  "random_seeds": [
    1,
    2,
    3,
    4,
    5
  ],
  "datasets": {
    "include_real": [
      "yemen_tax_revenue"
    ],
    "include_synthetic": [
      "synthetic_linear_ar",
      "synthetic_nonlinear_sine",
      "synthetic_regime_switching",
      "synthetic_spiky_outbreak",
      "synthetic_noisy_seasonal"
    ],
    "synthetic_lengths": [
      180
    ],
    "noise_levels": [
      0.0,
      0.05,
      0.1,
      0.2
    ]
  },
  "models": [
    "naive_1",
    "seasonal_naive",
    "drift",
    "arima",
    "ets",
    "theta",
    "svr",
    "xgboost",
    "legacy_nfpso",
    "projected_constricted_nfpso"
  ],
  "forecasting": {
    "horizon": 1,
    "evaluation_protocol": "rolling_origin",
    "split_policy": "chronological",
    "normalization": "train_only",
    "metrics": [
      "mae",
      "rmse",
      "mape",
      "smape",
      "mase"
    ]
  },
  "nfpso": {
    "default_n_lags": 5,
    "scale_min": 0.1,
    "scale_max": 0.9,
    "validation_fraction": 0.2,
    "activation_floor": 0.0001,
    "activation_penalty_weight": 0.01,
    "sensitivity_weight": 0.001,
    "objective": "composite"
  },
  "radius_sweep": {
    "enabled": true,
    "radius_values": [
      0.35,
      0.45,
      0.55,
      0.65,
      0.75
    ],
    "particles": 12,
    "iterations": 40
  },
  "noise_sensitivity": {
    "enabled": true,
    "noise_levels": [
      0.0,
      0.01,
      0.05,
      0.1,
      0.2
    ],
    "trials": 20
  },
  "seed_study": {
    "enabled": true,
    "seeds": [
      1,
      2,
      3,
      4,
      5
    ],
    "particles": 12,
    "iterations": 40
  },
  "pso_budget_sweep": {
    "enabled": true,
    "budgets": [
      {
        "particles": 5,
        "iterations": 5
      },
      {
        "particles": 10,
        "iterations": 20
      },
      {
        "particles": 12,
        "iterations": 40
      }
    ]
  },
  "statistics": {
    "enabled": true,
    "tests": [
      "friedman",
      "wilcoxon_holm",
      "bootstrap_ci"
    ],
    "bootstrap_repeats": 1000,
    "alpha": 0.05
  },
  "reporting": {
    "make_tables": true,
    "make_figures": true,
    "paper_tables_dir": "outputs/q1_minimal/paper_tables",
    "paper_figures_dir": "outputs/q1_minimal/paper_figures"
  }
}